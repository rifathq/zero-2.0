{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access control and contact information",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier matching the Firebase Auth UID",
          "maxLength": 128
        },
        "firebaseUid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128
        },
        "firstName": {
          "type": "string",
          "description": "First name of user",
          "maxLength": 100
        },
        "lastName": {
          "type": "string",
          "description": "Last name of user",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of user",
          "maxLength": 254
        },
        "phone": {
          "type": "string",
          "description": "Phone number with country code",
          "maxLength": 30
        },
        "photoURL": {
          "type": "string",
          "description": "URL of avatar image",
          "maxLength": 1024
        },
        "role": {
          "type": "string",
          "description": "Role of the user: customer, seller, reseller, or admin",
          "enum": ["customer", "seller", "reseller", "admin"]
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the user email is verified"
        },
        "phoneVerified": {
          "type": "boolean",
          "description": "Whether the user phone is verified"
        },
        "status": {
          "type": "string",
          "description": "Account status",
          "enum": ["active", "suspended", "pending"]
        },
        "linkedProviders": {
          "type": "array",
          "description": "List of linked authentication provider IDs"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 update timestamp"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 last login timestamp"
        }
      },
      "required": ["id", "firebaseUid", "email", "role", "status", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrative user lookup",
      "type": "object",
      "properties": {
        "adminUid": {
          "type": "string",
          "description": "Admin UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Admin email",
          "maxLength": 254
