          "type": "string",
          "description": "User ID of the reviewer",
          "maxLength": 128
        },
        "orderNumber": {
          "type": "string",
          "description": "Associated order number verifying purchase",
          "maxLength": 64
        },
        "helpfulCount": {
          "type": "number",
          "description": "Helpful upvote count"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 creation timestamp"
        }
      },
      "required": ["id", "productId", "author", "rating", "title", "comment", "verifiedPurchase", "createdAt"]
    },
