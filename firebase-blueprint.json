      "required": ["adminUid", "email"]
    },
    "ProductReview": {
      "title": "ProductReview",
      "description": "Customer product reviews with star ratings and verified purchase linkage",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the review",
          "maxLength": 128
        },
        "productId": {
          "type": "string",
          "description": "ID of the reviewed product",
          "maxLength": 128
        },
        "author": {
          "type": "string",
          "description": "Display name of reviewer",
          "maxLength": 100
        },
        "rating": {
          "type": "number",
          "description": "Star rating between 1 and 5",
          "minimum": 1,
          "maximum": 5
        },
        "title": {
          "type": "string",
          "description": "Review headline or title",
          "maxLength": 200
        },
        "comment": {
          "type": "string",
          "description": "Full review text feedback",
          "maxLength": 2000
        },
        "verifiedPurchase": {
          "type": "boolean",
          "description": "Whether the review is linked to an authenticated order"
        },
