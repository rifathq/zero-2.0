# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Marketplace API configuration
# Connect to production or staging multi-vendor backend services
NEXT_PUBLIC_API_BASE_URL="https://api.zeroinvest.com/v1"
VITE_API_BASE_URL="https://api.zeroinvest.com/v1"

# Firebase runtime integration switch
# Set to "true" to connect to Firebase Authentication and Cloud Firestore
# Set to "false" to run in local standalone demo mode with local authentication
VITE_FIREBASE_ENABLED="false"

# =================================================================
# PHASE 5: BACKEND, PAYMENT GATEWAYS & COURIER CONFIGURATION
# (Server-only secrets: NEVER expose to browser bundles)
# =================================================================

# Server Port
PORT=3000

# Backend Cron / Scheduled Tasks Secret Token
CRON_SECRET_TOKEN="your_secure_cron_secret_token_here"

# --- bKash Merchant API Configuration ---
# Status: REQUIRES MERCHANT CREDENTIALS
PAYMENT_PROVIDER_BKASH="bkash"
BKASH_APP_KEY="your_bkash_app_key"
BKASH_APP_SECRET="your_bkash_app_secret"
BKASH_USERNAME="your_bkash_username"
BKASH_PASSWORD="your_bkash_password"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_WEBHOOK_SECRET="your_bkash_webhook_secret"

# --- Nagad Merchant API Configuration ---
# Status: REQUIRES MERCHANT CREDENTIALS
PAYMENT_PROVIDER_NAGAD="nagad"
NAGAD_MERCHANT_ID="your_nagad_merchant_id"
NAGAD_PUBLIC_KEY="your_nagad_public_key"
NAGAD_PRIVATE_KEY="your_nagad_private_key"
NAGAD_BASE_URL="http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs"
NAGAD_WEBHOOK_SECRET="your_nagad_webhook_secret"

# --- SSLCommerz Merchant API Configuration ---
# Status: REQUIRES MERCHANT CREDENTIALS
PAYMENT_PROVIDER_SSLCOMMERZ="sslcommerz"
SSLCOMMERZ_STORE_ID="your_sslcommerz_store_id"
SSLCOMMERZ_STORE_PASSWORD="your_sslcommerz_store_password"
SSLCOMMERZ_BASE_URL="https://sandbox.sslcommerz.com"
SSLCOMMERZ_IS_SANDBOX="true"
SSLCOMMERZ_IPN_SECRET="your_sslcommerz_ipn_secret"

# --- Pathao Courier API Configuration ---
# Status: REQUIRES COURIER CREDENTIALS
PATHAO_CLIENT_ID="your_pathao_client_id"
PATHAO_CLIENT_SECRET="your_pathao_client_secret"
PATHAO_USERNAME="your_pathao_username"
PATHAO_PASSWORD="your_pathao_password"
PATHAO_BASE_URL="https://courier-api-sandbox.pathao.com"
PATHAO_STORE_ID="your_pathao_store_id"

# --- Steadfast Courier API Configuration ---
# Status: REQUIRES COURIER CREDENTIALS
STEADFAST_API_KEY="your_steadfast_api_key"
STEADFAST_SECRET_KEY="your_steadfast_secret_key"
STEADFAST_BASE_URL="https://portal.steadfast.com.bd/api/v1"

# --- RedX Courier API Configuration ---
# Status: REQUIRES COURIER CREDENTIALS
REDX_API_TOKEN="your_redx_api_token"
REDX_BASE_URL="https://sandbox.redx.com.bd/v1.0.0-beta"

# Courier Webhook Authentication Secret
COURIER_WEBHOOK_SECRET="your_courier_webhook_secret"
